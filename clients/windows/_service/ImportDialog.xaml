<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить профиль — GeoRoute" Width="640" Height="730" MinWidth="520" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="#0F1825" Foreground="#EEF4FC" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#18283B"/><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="BorderBrush" Value="#3D536C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#91F2D2"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#18283B"/><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#2E4B60"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EEF4FC"/><Setter Property="Background" Value="#18283B"/><Setter Property="BorderBrush" Value="#3D536C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,8,28,8" VerticalAlignment="Center"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#91F2D2"/></Grid></Border>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
      <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="#18283B" BorderBrush="#3D536C" BorderThickness="1" MinWidth="190" MaxHeight="250"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="26" Background="#0F1825">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Image x:Name="DialogImportIcon" Width="52" Height="52" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Добавить профиль" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="IP, страна и сервис — файл создадим сами" Foreground="#9CAEC4" FontSize="13" Margin="0,6,0,0"/></StackPanel></StackPanel>
      <Button Grid.Column="1" x:Name="ImportHelpButton" Content="?" Width="38" Height="38" FontSize="20" VerticalAlignment="Center" ToolTip="Как добавить профиль" AutomationProperties.Name="Инструкция по добавлению профиля"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,10,10">
        <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
          <RadioButton x:Name="CreateByIP" Content="По IP-адресу" GroupName="ProfileInput" IsChecked="True" Margin="0,0,10,0"/>
          <RadioButton x:Name="CreateFromFile" Content="Из файла" GroupName="ProfileInput"/>
        </StackPanel>
        <StackPanel x:Name="AddressPanel">
          <TextBlock Text="IP-адрес сервера" Foreground="#B9CBE0" FontSize="12" Margin="0,0,0,7"/>
          <TextBox x:Name="ServerAddressBox" MaxLength="64" AutomationProperties.Name="IP-адрес нового сервера"/>
          <TextBlock Text="Адрес GeoHide или совместимого сервера. Без http:// и порта." Foreground="#8FA6C1" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,18"/>
          <TextBlock Text="Сервис" Foreground="#B9CBE0" FontSize="12" Margin="0,0,0,7"/>
          <ComboBox x:Name="ServiceBox" SelectedIndex="0" AutomationProperties.Name="Сервис для нового профиля" Margin="0,0,0,18">
            <ComboBoxItem Tag="ChatGPT" Content="ChatGPT"/><ComboBoxItem Tag="Gemini" Content="Gemini"/>
          </ComboBox>
        </StackPanel>
        <StackPanel x:Name="FilePanel" Visibility="Collapsed" Margin="0,0,0,18">
          <TextBlock Text="Готовый файл .hosts" Foreground="#B9CBE0" FontSize="12" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#152235" BorderBrush="#31465E" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,12,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectedFileText" Text="Файл не выбран" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock x:Name="FileStatsText" Text="Файл .hosts до 1 МиБ" Foreground="#8FA6C1" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Button Grid.Column="1" x:Name="BrowseFileButton" Content="Выбрать файл…" VerticalAlignment="Center" MinHeight="39"/>
          </Grid>
        </StackPanel>
        <TextBlock Text="Страна или регион" Foreground="#B9CBE0" FontSize="12" Margin="0,0,0,7"/>
        <ComboBox x:Name="CountryBox" SelectedIndex="0" AutomationProperties.Name="Страна или регион нового сервера">
      <ComboBoxItem Tag="US" Content="США"/><ComboBoxItem Tag="EU" Content="Европа"/><ComboBoxItem Tag="RU" Content="Россия"/>
      <ComboBoxItem Tag="DE" Content="Германия"/><ComboBoxItem Tag="NL" Content="Нидерланды"/><ComboBoxItem Tag="FI" Content="Финляндия"/>
      <ComboBoxItem Tag="FR" Content="Франция"/><ComboBoxItem Tag="GB" Content="Великобритания"/><ComboBoxItem Tag="SE" Content="Швеция"/>
      <ComboBoxItem Tag="PL" Content="Польша"/><ComboBoxItem Tag="CA" Content="Канада"/><ComboBoxItem Tag="CH" Content="Швейцария"/>
      <ComboBoxItem Tag="TR" Content="Турция"/><ComboBoxItem Tag="JP" Content="Япония"/><ComboBoxItem Tag="SG" Content="Сингапур"/><ComboBoxItem Tag="ZZ" Content="Другая страна"/>
        </ComboBox>
        <TextBlock Text="Страна нужна для подписи и флага; местоположение сервера не меняется." Foreground="#8FA6C1" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,18"/>
        <TextBlock x:Name="ProfileNameLabel" Text="Название · необязательно" Foreground="#B9CBE0" FontSize="12" Margin="0,0,0,7"/>
        <TextBox x:Name="ProfileNameBox" MaxLength="60" AutomationProperties.Name="Название нового профиля, необязательно при создании по IP"/>
        <TextBlock x:Name="ProfileNameHelp" Text="Оставьте пустым — назовём по сервису и стране." Foreground="#8FA6C1" FontSize="11" Margin="0,6,0,14"/>
        <TextBlock Text="Сохранение добавит карточку. Для подключения выберите её и нажмите «Включить» на главной. Доступность сервера этим не проверяется." TextWrapping="Wrap" Foreground="#91A6BF" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="ImportErrorText" Text="" TextWrapping="Wrap" Foreground="#F4CD8C" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelImportButton" Content="Отмена" IsCancel="True" MinWidth="100" Margin="0,0,12,0"/><Button x:Name="ConfirmImportButton" Content="Сохранить профиль" IsDefault="True" MinWidth="168"/></StackPanel>
    </StackPanel>
  </Grid>
</Window>
