<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GeoRoute — подробности проверок" Width="780" Height="690" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#0C121C" Foreground="#EDF4FD" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#21394D"/><Setter Property="Foreground" Value="#EDF4FD"/><Setter Property="Padding" Value="18,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10" BorderBrush="#49617D" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#142131"/><Setter Property="Foreground" Value="#DDE8F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  </Window.Resources>
  <Grid Margin="22" Background="#0C121C"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock x:Name="DetailsTitle" Text="{Binding Address}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Локальные проверки ChatGPT. Ничего не подключает и не запускает новую проверку." Foreground="#A4B7CE" FontSize="12" Margin="0,7,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,10,0">
        <Border Background="#182A3D" CornerRadius="14" Padding="16" Margin="0,0,0,14"><StackPanel>
          <TextBlock Text="Последний результат" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock Text="{Binding ProbeTimeLabel}" Foreground="#A4B7CE" FontSize="12" Margin="0,6,0,8"/>
          <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="{Binding TCPDetail}" Margin="0,0,18,6"/>
            <TextBlock Text="{Binding TLSDetail}" Margin="0,0,18,6"/>
            <TextBlock Text="{Binding HTTPDetail}" Margin="0,0,0,6"/>
          </WrapPanel>
          <TextBlock Text="{Binding ReasonLabel}" FontWeight="SemiBold"/>
          <Expander Header="Что означают TCP, TLS и HTTP" Foreground="#A4B7CE" FontSize="12" Margin="0,10,0,0"><TextBlock Text="TCP — соединение с сервером. TLS — защищённое соединение. HTTP — код ответа сайта." Margin="0,8,0,0"/></Expander>
          <Expander Header="Gemini, вложения и страна выхода" Foreground="#A4B7CE" FontSize="12" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
            <TextBlock Text="{Binding GeminiLabel}"/>
            <TextBlock Text="{Binding GeminiError}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding FilesDetail}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding ExitDetail}" Margin="0,4,0,0"/>
          </StackPanel></Expander>
          <Expander Header="Полный текст ошибки — можно скопировать" Foreground="#A4B7CE" FontSize="12" Margin="0,8,0,0">
            <TextBox x:Name="TechnicalDetails" Text="{Binding ReasonHint}" MaxHeight="180" Margin="0,10,0,0" AutomationProperties.Name="Полный технический результат проверки"/>
          </Expander>
        </StackPanel></Border>
        <TextBlock Text="История ChatGPT" FontWeight="SemiBold" FontSize="17"/>
        <TextBlock Text="{Binding HistoryCount}" Foreground="#91F2D2" Margin="0,6,0,4"/>
        <TextBlock Text="{Binding HistoryPeriod}" Foreground="#A4B7CE" FontSize="12"/>
        <TextBlock Text="До 24 завершённых проверок; новые сверху. Это результаты отдельных проверок, а не непрерывный мониторинг." Foreground="#A4B7CE" FontSize="12" Margin="0,5,0,12"/>
        <ItemsControl x:Name="HistoryEntries" ItemsSource="{Binding HistoryEntries}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="#2B4057" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{Binding Time}" FontSize="12"/><TextBlock Text="{Binding Latency}" Foreground="#A4B7CE" FontSize="11" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Result}" Foreground="{Binding Color}" FontWeight="SemiBold"/><TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#A4B7CE" Margin="0,4,0,0"/></StackPanel>
          </Grid></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Button x:Name="CloseDetails" Grid.Row="2" Content="Закрыть" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,14,0,0"/>
  </Grid>
</Window>
