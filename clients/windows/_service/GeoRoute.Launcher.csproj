<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GeoRoute</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/GeoRoute,$(BaseIntermediateOutputPath)=/src/obj</PathMap>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <ApplicationManifest>NextDNS.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NextDNS.Launcher.cs" />
    <Reference Include="System.Management.Automation">
      <HintPath>$(PowerShellAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidatePowerShellReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PowerShellAssembly)')" Text="Build via Build-Launcher.ps1 from Windows PowerShell 5.1 to resolve its installed engine." />
  </Target>
</Project>
