<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GeoRoute" Width="1220" Height="950" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#0C121C" Foreground="#EDF4FD" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9CAEC4" />
    <Style TargetType="TextBlock">
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="Image">
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#1B2C40" />
      <Setter Property="Foreground" Value="#E8F1FC" />
      <Setter Property="BorderBrush" Value="#354A63" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style TargetType="Control">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate>
                  <Border BorderThickness="2" BorderBrush="#91F2D2" CornerRadius="16" Margin="-3" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="12" Margin="-7" />
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.06" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#739FB4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A4B7CE" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A4B7CE" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,14" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="GeoModeStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#D6E4F4" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" Background="#1B2C40" BorderBrush="#354A63" BorderThickness="1" CornerRadius="12" Padding="16,11">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="#254550" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="#91F2D2" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="BorderBrush" Value="#91F2D2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#9CAEC4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111E2D" />
      <Setter Property="Foreground" Value="#DBE8F7" />
      <Setter Property="BorderBrush" Value="#2E425A" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CaretBrush" Value="#91F2D2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#7F9AB6" FontSize="{TemplateBinding FontSize}" Margin="{TemplateBinding Padding}" Visibility="Collapsed" IsHitTestVisible="False" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#1C2D42" />
      <Setter Property="Foreground" Value="#EEF4FC" />
      <Setter Property="BorderBrush" Value="#49617D" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxWidth" Value="440" />
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="ScrollDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb" MinHeight="24">
                    <Thumb.Template>
                      <ControlTemplate>
                        <Border Background="#3B506A" CornerRadius="4" Margin="2" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="ScrollIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="ScrollDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="ScrollIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PageCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="22"/>
      <Setter Property="BorderBrush" Value="#2A4256"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182E3C" Offset="0"/><GradientStop Color="#121F30" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E1ECF7"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="ToggleSurface" Background="#132332" BorderBrush="#2B4054" BorderThickness="1" CornerRadius="14" Padding="15,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#35495C">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4" HorizontalAlignment="Left" Fill="#D9E8F6"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#91F2D2"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#173A35"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#537D88"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#91F2D2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleSurface" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="PageRoot" Background="#0C121C">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#101B29" BorderBrush="#233348" BorderThickness="0,0,1,0">
      <Grid Margin="15,24,15,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="98" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="49" Height="49" Margin="-4,0,5,0" />
            <TextBlock Text="GeoRoute" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="ПОДКЛЮЧЕНИЕ К СЕРВИСАМ" Foreground="#738CA9" FontSize="9" Margin="7,10,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Подключение">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="HomeNavFallback" Text="◉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="HomeNavIcon" Width="34" Height="34"/>
              </Grid>
              <TextBlock Text="Подключение" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="ServersNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Список серверов">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="ServersNavFallback" Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="ServersNavIcon" Width="34" Height="34" />
              </Grid>
              <TextBlock Text="Серверы" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="MonitorNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Мониторинг">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="MonitorNavFallback" Text="▥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="MonitorNavIcon" Width="34" Height="34"/>
              </Grid>
              <TextBlock Text="Мониторинг" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Обзор подключения">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="OverviewNavFallback" Text="" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="OverviewNavIcon" Width="34" Height="34" />
              </Grid>
              <TextBlock Text="Помощь" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="JournalNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Журнал">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="JournalNavFallback" Text="≡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="JournalNavIcon" Width="34" Height="34"/>
              </Grid>
              <TextBlock Text="Журнал" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Настройки">
            <StackPanel Orientation="Horizontal">
              <Grid Width="34" Height="34" Margin="-4,0,8,0">
                <TextBlock x:Name="SettingsNavFallback" Text="⚙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="SettingsNavIcon" Width="34" Height="34"/>
              </Grid>
              <TextBlock Text="Настройки" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button x:Name="HideToTrayButton" Content="Свернуть в трей" Style="{StaticResource QuietButton}" Margin="0,0,0,8" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="0" />
        <RowDefinition Height="0" />
        <RowDefinition Height="22" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Обзор подключения" FontSize="26" FontWeight="SemiBold" />
          <TextBlock x:Name="PageSubtitle" Text="Текущее состояние, причины и следующее действие" Foreground="#8FA6C2" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel x:Name="MonitorTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0" Visibility="Collapsed">
          <RadioButton x:Name="MonitorServersTab" Content="Серверы GeoHide" GroupName="MonitorView" Style="{StaticResource GeoModeStyle}" FontSize="12" Margin="0,0,8,0"/>
          <RadioButton x:Name="MonitorDnsTab" Content="DNS-провайдеры" GroupName="MonitorView" Style="{StaticResource GeoModeStyle}" FontSize="12"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" Grid.RowSpan="3">
        <StackPanel Margin="0,0,12,20">
          <Border Background="#142131" CornerRadius="20" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Обновить адреса в памяти Windows" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Windows запоминает адреса сайтов. После смены сервера старый адрес может мешать подключению. Эта кнопка обновит DNS-кеш. Она не закрывает старые соединения браузера и не удаляет историю." TextWrapping="Wrap" Foreground="#A4B7CE" Margin="0,10,0,16" />
              <Button x:Name="CheckButton" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Padding="8,3,16,3" AutomationProperties.Name="Очистить DNS кеш Windows и повторить проверку" Margin="0">
                <StackPanel Orientation="Horizontal">
                  <Image x:Name="CheckIcon" Width="48" Height="48" Margin="0,0,7,0" />
                  <TextBlock Text="Очистить DNS-кеш" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Background="#142131" CornerRadius="20" Padding="22" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="GIF, видео или ZIP не открываются" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Сначала проверьте выбранный маршрут в разделе «Серверы». Помощник проверит настройки вложений и при необходимости предложит перезапуск браузера, чтобы закрыть зависшие соединения." TextWrapping="Wrap" Foreground="#A4B7CE" Margin="0,10,0,16" />
              <Button x:Name="RepairButton" Content="GIF / вложения не работают…" Style="{StaticResource ActionButton}" Margin="0" VerticalAlignment="Center" AutomationProperties.Name="Диагностика и восстановление вложений" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Expander Header="Подробная диагностика ChatGPT, DNS и кеша" Foreground="#A4B7CE" Margin="0,8,0,0">
            <StackPanel Margin="0,12,0,0">
              <Border x:Name="HeroCard" CornerRadius="24" BorderThickness="1" BorderBrush="#345865" Padding="22,18">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B3942" Offset="0" />
                    <GradientStop Color="#14293A" Offset="0.65" />
                    <GradientStop Color="#142233" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border x:Name="HealthPill" Background="#3D3C2D" CornerRadius="7" Padding="8,4">
                        <TextBlock x:Name="HealthBadge" Text="ПРОВЕРЯЮ МАРШРУТ" FontSize="11" FontWeight="Bold" Foreground="#EDD49F" />
                      </Border>
                      <TextBlock Text="ПРЯМО СЕЙЧАС" Foreground="#8CA7BB" FontSize="9" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="HealthTitle" Text="Проверяю подключение…" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="HealthDescription" Text="Читаю настройки Windows и проверяю сетевой маршрут." Foreground="#AEC6D9" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <Button x:Name="CacheButton" Style="{StaticResource ActionButton}" Background="#98EFD5" Foreground="#0F302A" BorderBrush="#98EFD5" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="10,4,17,4" AutomationProperties.Name="Проверить текущие настройки и сетевой маршрут">
                      <StackPanel Orientation="Horizontal">
                        <Image x:Name="CacheIcon" Width="48" Height="48" Margin="0,0,8,0" />
                        <TextBlock Text="Проверить снова" VerticalAlignment="Center" FontSize="13" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="6,0,-10,0" IsHitTestVisible="False">
                    <Border x:Name="ArtFallback" Background="#183747" CornerRadius="22" />
                    <TextBlock x:Name="ArtFallbackGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#528E9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="HeroImage" Stretch="Uniform" AutomationProperties.Name="Стеклянная орбитальная скульптура" />
                  </Grid>
                </Grid>
              </Border>
              <Border Background="#142132" BorderBrush="#2A3F56" BorderThickness="1" CornerRadius="20" Padding="17,13" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Image x:Name="ActiveFlag" Width="64" Height="48" Margin="0,0,13,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="ПРОФИЛЬ HOSTS" Foreground="#859DB9" FontSize="9" />
                      <Border x:Name="StatusPill" Background="#1D443D" CornerRadius="5" Padding="5,2" Margin="9,-2,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse x:Name="StatusDot" Width="4" Height="4" Fill="#91F2D2" Margin="0,0,4,0" />
                          <TextBlock x:Name="StatusBadge" Text="HOSTS" FontSize="8" Foreground="#91F2D2" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusTitle" Text="Читаю системный hosts…" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock x:Name="AddressText" Text="—" Foreground="#96B4CE" FontFamily="Consolas" FontSize="12" />
                      <TextBlock x:Name="EntriesText" Text="" Foreground="#7895B2" FontSize="12" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDescription" Visibility="Collapsed" />
                  </StackPanel>
                  <Button Grid.Column="2" x:Name="ChangeServerButton" Content="Сменить сервер →" Style="{StaticResource QuietButton}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid Margin="2,18,2,4" x:Name="HealthDetailsPanel">
                <Grid.RowDefinitions>
                  <RowDefinition Height="48" />
                  <RowDefinition Height="48" />
                  <RowDefinition Height="48" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ChatGPT" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="AppHealthText" Text="Определяю приложение…" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" x:Name="OpenAppButton" Content="Открыть ↗" Style="{StaticResource QuietButton}" VerticalAlignment="Center" IsEnabled="False" />
                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#223449" BorderThickness="0,1,0,0" />
                <TextBlock Grid.Row="1" Text="Маршрут" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RouteHealthText" Text="DNS / TLS / HTTP проверяются в фоне" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RouteTimeText" Text="" Foreground="#7EA2B6" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#223449" BorderThickness="0,1,0,0" />
                <TextBlock Grid.Row="2" Text="Кеш и журнал" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheHealthText" Text="Собираю сведения…" Foreground="#9FB4CF" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LogsSizeText" Text="" Foreground="#7EA2B6" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Grid x:Name="ToolsPanel" Margin="0,7,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              </Grid>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="GeoPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Margin="0,0,4,4">
