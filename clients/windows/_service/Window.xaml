            <Border Background="#153036" CornerRadius="18" Padding="18" Margin="0,0,4,16">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="GeoHide умеет больше, чем ChatGPT" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Добавьте другие сайты и выберите для них DNS. Остальные сайты останутся на вашем обычном DNS." Foreground="#AFC5D6" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,6"/><TextBlock x:Name="DnsSitesSummary" Text="DNS для выбранных сайтов выключен" Foreground="#91F2D2" TextWrapping="Wrap" FontSize="12"/></StackPanel>
                <Button Grid.Column="1" x:Name="DnsSitesButton" Content="Сайты и DNS…" Style="{StaticResource ActionButton}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <UniformGrid x:Name="ProfilesPanel" Columns="2" VerticalAlignment="Top" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#172C3A" BorderBrush="#345569" BorderThickness="1" CornerRadius="20" Padding="15,11" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SelectedProfileText" Text="Выберите профиль" FontWeight="SemiBold" FontSize="14" />
              <TextBlock x:Name="SelectedProfileDetail" Text="Изменения применяются отдельно" Foreground="#8DAFC6" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RestoreButton" Style="{StaticResource QuietButton}" Margin="12,0" Padding="4,2,9,2">
              <StackPanel Orientation="Horizontal">
                <Image x:Name="PowerIcon" Width="44" Height="44" Margin="0,0,3,0" />
                <TextBlock Text="Отключить" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" x:Name="ApplyProfileButton" Content="Подключить" Style="{StaticResource ActionButton}" Background="#98EFD5" Foreground="#103129" BorderBrush="#98EFD5" MinWidth="138" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
      <TextBlock Grid.Row="4" Text="Настройки и диагностика локальны. Вход в аккаунт сохраняется." Foreground="#647F9D" FontSize="10" Margin="2,9,0,0" />
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,20">
          <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="GeoRoute под вас" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Запуск, движение интерфейса и дополнительные возможности." TextWrapping="Wrap" Foreground="#A4B7CE" FontSize="13" Margin="0,9,16,0"/></StackPanel>
              <Image x:Name="SettingsHeaderArt" Grid.Column="1" Width="82" Height="82" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Приложение" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="StartWithWindows" Style="{StaticResource SettingsToggle}" Content="Открывать GeoRoute в трее при входе в Windows" ToolTip="Запускать менеджер в трее после входа в Windows"/>
              <CheckBox x:Name="ReducedMotion" Style="{StaticResource SettingsToggle}" Content="Уменьшить анимации" AutomationProperties.Name="Уменьшить движение интерфейса" ToolTip="Также учитываются системные настройки анимаций Windows"/>
              <TextBlock Text="Закрытие окна сворачивает GeoRoute в трей. Полный выход останавливает мониторинг, а применённые адреса сохраняются в Windows." TextWrapping="Wrap" Foreground="#9CAEC4" FontSize="12" Margin="2,13,2,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Журналы и поддержка" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="История действий помогает понять, что произошло с подключением." TextWrapping="Wrap" Foreground="#9CAEC4" FontSize="12" Margin="0,7,0,12"/><Button x:Name="OpenLogButton" Content="Открыть папку журналов ↗" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel>
          </Border>
          <Border Style="{StaticResource PageCard}" Margin="0,0,0,16">
          <Expander Header="Прокси, NextDNS и технические сведения" Foreground="#A4B7CE" Margin="0,10,0,20">
            <StackPanel Margin="0,14,0,0">
              <Button x:Name="HttpProxyButton" Content="US-прокси…" Style="{StaticResource QuietButton}" Margin="0,0,0,12" FontSize="12" ToolTip="Настройка настольного ChatGPT / Dot" />
              <TextBlock x:Name="TransportStatusText" Text="NextDNS: проверяю службу…" Foreground="#AFC5D6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock x:Name="ProxyText" Text="" Foreground="#7890AD" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />
              <TextBlock x:Name="ManagerStatusText" Text="● Менеджер работает" Foreground="#98EFD5" FontSize="12" Margin="0,0,0,12" />
              <TextBlock x:Name="HealthAtText" Text="Диагностика при запуске…" Foreground="#9CB5CF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,12" />
              <TextBlock x:Name="LastReadText" Text="" Foreground="#667F9D" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,12" />
            </StackPanel>
          </Expander>
          </Border>
          <Button x:Name="ExitManagerButton" Content="Выйти из GeoRoute" Style="{StaticResource QuietButton}" Foreground="#E8AEA8" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Завершить менеджер. Настройки DNS и hosts сохранятся."/>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="JournalPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource PageCard}" Margin="0,0,0,16" Padding="20,15">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Что происходит с подключением" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Действия, проверки и ошибки — в одном месте. Используйте фильтр или поиск." TextWrapping="Wrap" Foreground="#A4B7CE" FontSize="12" Margin="0,8,16,0"/></StackPanel>
            <Image x:Name="JournalHeaderArt" Grid.Column="1" Width="70" Height="70" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" x:Name="JournalCard" Background="#101C2B" BorderBrush="#2A3F56" BorderThickness="1" CornerRadius="22">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="49" />
              <RowDefinition Height="39" />
              <RowDefinition Height="3" />
              <RowDefinition Height="*" />
              <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Grid Margin="14,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Image x:Name="LogIcon" Width="40" Height="40" Margin="-3,0,5,0" />
                <TextBlock Text="Журнал" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="ActionTitle" Grid.Column="1" Text="Готово к работе" Foreground="#8FAAC5" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
              <Button Grid.Column="2" x:Name="CopyLogButton" Content="Копировать" Style="{StaticResource QuietButton}" />
              <Button Grid.Column="3" x:Name="ClearLogButton" Content="Очистить…" Style="{StaticResource QuietButton}" />
            </Grid>
            <Grid Grid.Row="1" Margin="14,0,15,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterAllButton" Content="Все" Style="{StaticResource QuietButton}" Padding="10,5" />
                <Button x:Name="FilterErrorsButton" Content="Ошибки" Style="{StaticResource QuietButton}" Padding="10,5" />
                <Button x:Name="FilterActionsButton" Content="Действия" Style="{StaticResource QuietButton}" Padding="10,5" />
              </StackPanel>
              <TextBox Grid.Column="1" x:Name="LogSearchBox" MaxWidth="220" HorizontalAlignment="Right" MinWidth="135" Margin="12,0,13,0" FontSize="12" Padding="9,6" AutomationProperties.Name="Поиск в журнале" ToolTip="Поиск по тексту журнала" Tag="Поиск по журналу" />
              <CheckBox Grid.Column="2" x:Name="AutoScrollCheck" Content="Автопрокрутка" IsChecked="True" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Grid.Row="2" x:Name="ActivityBar" Minimum="0" Maximum="100" Value="0" Height="3" Foreground="#91F2D2" Background="#1D3044" BorderThickness="0" />
            <ListBox Grid.Row="3" x:Name="LogBox" Background="#0E1825" Foreground="#BACDE2" BorderThickness="0" Padding="14,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Живой журнал событий">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0,3" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="5">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#253D54" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Grid.Row="4" x:Name="ActivityDetail" Text="Диагностика запущена автоматически" Foreground="#829DB9" FontSize="12" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="HomePage" Grid.Row="1" Grid.RowSpan="3">
        <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
          <TextBlock x:Name="HomeTitle" Text="Выключено" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,28" />
          <Button x:Name="HomeToggle" Width="180" Height="180" Cursor="Hand" Foreground="#91F2D2" HorizontalAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="PowerSurface" Background="#142B35" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2" CornerRadius="90">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="68" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PowerSurface" Property="Background" Value="#234650" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PowerSurface" Property="Opacity" Value="0.45" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock x:Name="HomeToggleCaption" Text="Включить" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
          <TextBlock x:Name="HomeRoute" Text="US + EU" Foreground="#B3C9DD" FontSize="16" TextAlignment="Center" Margin="0,28,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="HomeDetail" Text="Проверяю настройки…" Foreground="#9CAEC4" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
          <TextBlock x:Name="HomeDnsSummary" Text="Другие сайты: DNS выключен" Foreground="#9CAEC4" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0" />
          <TextBlock Text="При включении или выключении Windows попросит подтверждение." Foreground="#7890AD" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,26,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
