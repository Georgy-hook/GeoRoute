<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Как добавить профиль — GeoRoute" Width="650" Height="730" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#0F1825" Foreground="#EEF4FC" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
    <Style x:Key="Step" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,20,0,6"/></Style>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9CBE0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
  </Window.Resources>
  <Grid Margin="26" Background="#0F1825">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Как добавить профиль" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="Профиль — это готовый список адресов для подключения к сервисам." Style="{StaticResource Description}" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,16,16">
        <Border Background="#1B3440" CornerRadius="14" Padding="16">
          <TextBlock Text="Для обычного подключения ничего добавлять не нужно. В разделе «Серверы» уже есть профили ChatGPT и Gemini. Выберите подходящий и нажмите «Включить» на главной." Foreground="#B6F3DF"/>
        </Border>
        <TextBlock Text="1. Откройте создание профиля" Style="{StaticResource Step}"/>
        <TextBlock Text="Перейдите в «Серверы» → «Добавить сервер». По умолчанию выбран способ «По IP-адресу»: готовить файл не нужно." Style="{StaticResource Description}"/>
        <TextBlock Text="2. Введите IP и выберите сервис" Style="{StaticResource Step}"/>
        <TextBlock Text="Укажите IP сервера GeoHide или другого совместимого сервера. Выберите ChatGPT или Gemini. Программа сама добавит адреса выбранного сервиса; для ChatGPT — также известные адреса вложений. Вводите только IP, без http:// и порта." Style="{StaticResource Description}"/>
        <TextBlock Text="3. Выберите страну и сохраните" Style="{StaticResource Step}"/>
        <TextBlock Text="Страна нужна для подписи и флага — она не меняет местоположение сервера. Название можно оставить пустым: например, получится «Gemini — Германия». Нажмите «Сохранить профиль»." Style="{StaticResource Description}"/>
        <TextBlock Text="4. Включите подключение" Style="{StaticResource Step}"/>
        <TextBlock Text="В списке появится новая карточка. Нажмите «Выбрать», затем «Включить» на главной и подтвердите Windows. Сохранение профиля само по себе подключение не переключает." Style="{StaticResource Description}"/>
        <TextBlock Text="Если у вас уже есть файл" Style="{StaticResource Step}"/>
        <TextBlock Text="В том же окне выберите «Из файла», укажите готовый .hosts, название и страну, затем нажмите «Сохранить профиль». Если файл находится в ZIP, сначала распакуйте архив. Ключ VPN вместо IP или файла .hosts не подходит." Style="{StaticResource Description}"/>
        <TextBlock Text="Если нужны разные IP для ChatGPT и вложений" Style="{StaticResource Step}"/>
        <TextBlock Text="Для изменения общей пары US + EU откройте «Мониторинг» и разверните «Адреса US + EU» под списком. Выберите «Вручную» и укажите адреса US и EU. Новый адрес сначала сохраните без подключения и проверьте кнопкой «Проверить серверы». Затем нажмите «Сохранить и подключить». Добавление IP в мониторинг само по себе не создаёт профиль." Style="{StaticResource Description}"/>
        <TextBlock Text="Если профиль не сохраняется" Style="{StaticResource Step}"/>
        <TextBlock Text="Прочитайте сообщение под полями и передайте его тому, кто дал вам файл. GeoRoute принимает профили только для поддерживаемых сервисов ChatGPT / OpenAI и Gemini. Если файл заканчивается на .txt, попросите версию .hosts. Размер файла — до 1 МБ." Style="{StaticResource Description}"/>
        <Border Background="#2D2A25" CornerRadius="14" Padding="16" Margin="0,20,0,0">
          <TextBlock Text="Сохранение проверяет формат IP и доменов, но не подтверждает работу чужого сервера. Пользовательские профили не заменяются автоподбором GeoHide. Если такой сервер перестал работать, потребуется новый файл или адрес от его поставщика." Foreground="#F6D595"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" x:Name="CloseProfileHelpButton" Content="Понятно" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="125" Margin="0,16,0,0"/>
  </Grid>
</Window>
