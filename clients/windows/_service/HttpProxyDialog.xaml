<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NextDNS — US-прокси ChatGPT" Width="660" Height="590" MinWidth="540" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#0C1623" Foreground="#E7F1FC" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#23384D"/><Setter Property="Foreground" Value="#DCEBFA"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#426686"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26">
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="Flag" Width="62" Height="62" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1"><TextBlock Text="Выход в США для ChatGPT" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Настольный ChatGPT / Dot и веб-версия" Foreground="#9FB4CF" Margin="0,6,0,0"/></StackPanel></Grid>
  <Border Background="#17373D" BorderBrush="#345865" BorderThickness="1" CornerRadius="18" Padding="18"><StackPanel><TextBlock x:Name="State" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Настройка сохраняется в Windows. После перезагрузки не нужно запускать это окно или держать менеджер открытым." TextWrapping="Wrap" Foreground="#B9CDDC" Margin="0,8,0,0"/></StackPanel></Border>
  <TextBlock Text="HTTP-прокси без авторизации · IPv4:порт" Margin="0,20,0,8" Foreground="#B9CDDC"/>
  <TextBox x:Name="Server" Background="#142536" Foreground="#E7F1FC" BorderBrush="#426079" Padding="12" FontSize="18" AutomationProperties.Name="Адрес HTTP-прокси"/>
  <TextBlock Text="Можно заменить адрес новым. Перед включением проверим HTTPS и страну выхода: нужна US." TextWrapping="Wrap" Foreground="#9FB4CF" Margin="0,8,0,15"/>
  <WrapPanel><Button x:Name="Check" Content="Проверить"/><Button x:Name="Enable" Content="Проверить и включить" Background="#98EFD5" Foreground="#103129"/><Button x:Name="Disable" Content="Отключить"/></WrapPanel>
  <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Height="3" Margin="0,3,0,10"/>
  <TextBlock x:Name="Result" Text="Проверка ещё не выполнялась." TextWrapping="Wrap" Foreground="#CFDCE8" Margin="0,4,0,16"/>
  <Expander Header="Какие подключения затрагиваются" Foreground="#B9CDDC"><TextBlock Text="Через прокси: chatgpt.com, openai.com, oaistatic.com, oaiusercontent.com и все их поддомены, включая новые адреса вложений. Остальные сайты идут напрямую. Проверка сертификатов HTTPS сохраняется. Проверка выхода US сама по себе не проверяет воспроизведение конкретной GIF или сеанс управления компьютером." TextWrapping="Wrap" Margin="0,10,0,12"/></Expander>
 </StackPanel></ScrollViewer>
</Window>
