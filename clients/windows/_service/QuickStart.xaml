<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Начало работы · GeoRoute" Width="660" Height="680" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#171B21" Foreground="#EEF2F6" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EEF2F6"/><Setter Property="Background" Value="#29333E"/><Setter Property="BorderBrush" Value="#465462"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#91F2D2"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#171B21" Padding="28"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><Grid><TextBlock Text="Начало работы" Foreground="#A9B8C6"/><TextBlock x:Name="GuideCounter" HorizontalAlignment="Right" Foreground="#91F2D2" AutomationProperties.LiveSetting="Polite"/></Grid><ProgressBar x:Name="GuideProgress" Height="3" Background="#303A45" Foreground="#91F2D2" Margin="0,12,0,0" IsTabStop="False"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
   <StackPanel><TextBlock x:Name="GuideTitle" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="GuideSummary" Foreground="#B8C6D4" FontSize="15" LineHeight="23" Margin="0,12,0,12"/>
    <ItemsControl x:Name="GuideTasks"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#303A45" BorderThickness="0,1,0,0" Padding="0,15"><TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="22"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="#22322F" CornerRadius="8" Padding="15" Margin="0,12,0,12"><TextBlock x:Name="GuideNote" Foreground="#BDE7D9" LineHeight="21"/></Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="GuideBack" Content="Назад"/><Button x:Name="GuideClose" Grid.Column="1" Content="Закрыть" IsCancel="True" HorizontalAlignment="Left" Margin="10,0" Background="Transparent" BorderBrush="Transparent"/><Button x:Name="GuideNext" Grid.Column="2" Content="Далее" MinWidth="160" IsDefault="True" Background="#91F2D2" Foreground="#142B24" BorderBrush="#91F2D2"/></Grid>
 </Grid></Border>
</Window>
